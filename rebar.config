{erl_opts, [debug_info]}.
{deps, [
    {s2, "1.0.0"}
]}.

{project_plugins, [
    {rebar3_ex_doc, "0.3.0"}
]}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [hauntstack]}
]}.

{ex_doc, [
    {extras, ["README.md", "LICENSE.md"]},
    {main, "README.md"},
    {source_url, "https://github.com/chiroptical/hauntstack"}
]}.

{dialyzer, [
    {plt_extra_apps, [s2]}
]}.
